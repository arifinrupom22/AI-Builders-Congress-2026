{
  "name": "learnsphere-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LearnSphere AI - a source-grounded personal AI teacher that teaches from the student's own study materials. Built for the International AI Builders Congress 2026 (Challenge: AI Teacher) by team NITER_Parallax.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace web",
    "test": "npm run test --workspace server",
    "test:eval": "npm run test:eval --workspace server",
    "samples:seed": "node scripts/seed-samples.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
