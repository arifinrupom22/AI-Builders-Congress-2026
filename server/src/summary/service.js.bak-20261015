import { normaliseText, pdfOverviewText } from '../documents/extract.js';
import { docxToText, odtToText, legacyDocToText, rtfToText } from '../documents/office.js';
import { contentTokens, sentences } from '../retrieval/tokenize.js';
import { preparePassages, validateCitations, stripInvalidCitations, findUnsupportedQuotes, clampAnswer, screenPassage } from '../ai/grounding.js';
import { buildSummaryMessages, SUMMARY_LENGTHS, DEFAULT_SUMMARY_LENGTH } from '../ai/prompts.js';
import { extractKeyTerms } from '../ai/keyterms.js';

const LABELS = {
  en: {
    overview: 'Overview',
    points: 'Key points',
    terms: 'Key terms',
    order: 'Study order',
    local:
      'Local extractive summary: sentences were selected from your own material and quoted unchanged. No AI model was used.',
    pages: 'pages',
    firstRead: 'The material states directly on',
  },
  bn: {
    overview: 'সারসংক্ষেপ',
    points: 'মূল বিষয়',
    terms: 'মূল পরিভাষা',
    order: 'পড়ার ক্রম',
    local:
      'স্থানীয় extractive সারসংক্ষেপ: আপনার নিজের উপকরণ থেকে বাক্য বেছে নেওয়া হয়েছে এবং অপরিবর্তিতভাবে উদ্ধৃত করা হয়েছে। কোনো AI মডেল ব্যবহার করা হয়নি।',
    pages: 'পৃষ্ঠা',
    firstRead: 'উপকরণে সরাসরি বলা হয়েছে',
  },
};

/** Definition-like phrasing is a strong hint that a sentence introduces a term. */
const DEFINITION_HINTS = [
  /\b(is|are|means|refers to|is called|is defined as|consists of)\b/i,
  /(হল|বলে|বোঝায়|হয়|করা হয়)/,
];

/**
 * Choose passages spread evenly across the document rather than the first N.
 * The tail of the document is reserved for explicitly, so a long file never
 * produces a summary that stops halfway.
 */
export function selectSpread(passages, budget) {
  const total = passages.reduce((sum, p) => sum + p.text.length + 80, 0);
  if (total <= budget) return { selected: passages, truncated: false };

  const average = Math.max(1, total / Math.max(1, passages.length));
  const wanted = Math.max(2, Math.floor(budget / average));
  const stride = Math.max(1, Math.ceil(passages.length / wanted));
  const reserved = Math.floor(budget * 0.15);
  const selected = [];
  let used = 0;

  for (let index = 0; index < passages.length; index += stride) {
    const passage = passages[index];
    const cost = passage.text.length + 80;
    if (used + cost > budget - reserved) break;
    selected.push(passage);
    used += cost;
  }

  const last = passages.at(-1);
  if (last && !selected.includes(last) && used + last.text.length + 80 <= budget) selected.push(last);
  if (selected.length === 0 && passages.length > 0) selected.push(passages[0]);

  return { selected, truncated: selected.length < passages.length };
}

/**
 * A passage's first line becomes its heading, so a sentence lifted from the top
 * of a section can start with the heading glued on ("Photosynthesis - lecture
 * notes Photosynthesis is the process…"). Drop that prefix before quoting.
 */
function stripLeadingHeading(text, passage) {
  const heading = String(passage.heading ?? '').trim();
  if (!heading) return text;
  const lowered = text.toLowerCase();
  const start = heading.toLowerCase();
  if (!lowered.startsWith(start)) return text;
  return text.slice(heading.length).replace(/^[\s\-–—:|]+/, '').trim() || text;
}

/**
 * Rank sentences by how rare their terms are across the passages, with a nudge
 * for sentences that introduce a definition.
 */
function rankSentences(passages) {
  const total = Math.max(1, passages.length);
  const documentFrequency = new Map();
  const perPassage = passages.map((passage) =>
    sentences(passage.text).map((sentence) => stripLeadingHeading(sentence, passage)).filter((s) => s.length >= 40),
  );

  perPassage.forEach((list) => {
    const seen = new Set();
    for (const sentence of list) for (const token of new Set(contentTokens(sentence))) seen.add(token);
    for (const token of seen) documentFrequency.set(token, (documentFrequency.get(token) ?? 0) + 1);
  });

  const rarity = (token) => Math.log(1 + total / (1 + (documentFrequency.get(token) ?? 0)));
  const scored = [];

  perPassage.forEach((list, passageIndex) => {
    const passage = passages[passageIndex];
    list.forEach((sentence, sentenceIndex) => {
      // An extractive summary quotes material verbatim, so instruction-like text
      // must be filtered here for the same reason the AI path is told to.
      if (screenPassage(sentence).suspicious) return;
      const tokens = contentTokens(sentence);
      if (tokens.length < 4) return;
      const weight = tokens.reduce((sum, token) => sum + rarity(token), 0) / Math.sqrt(tokens.length);
      const bonus = DEFINITION_HINTS.some((re) => re.test(sentence)) ? 1.25 : 1;
      const positionBonus = 1 + Math.max(0, 0.2 - sentenceIndex * 0.03);
      scored.push({
        text: sentence.trim(),
        passage,
        passageIndex,
        sentenceIndex,
        score: weight * bonus * positionBonus,
      });
    });
  });

  scored.sort((a, b) => b.score - a.score);
  return scored;
}

/** Keep at most a couple of sentences per passage so one long passage cannot dominate. */
function pickSpread(scored, wanted) {
  const perPassageLimit = wanted <= 4 ? 1 : wanted <= 8 ? 2 : 3;
  const counts = new Map();
  const picked = [];

  for (const candidate of scored) {
    const count = counts.get(candidate.passageIndex) ?? 0;
    if (count >= perPassageLimit) continue;
    counts.set(candidate.passageIndex, count + 1);
    picked.push(candidate);
    if (picked.length >= wanted) break;
  }
  if (picked.length < Math.min(wanted, scored.length)) {
    for (const candidate of scored) {
      if (picked.includes(candidate)) continue;
      picked.push(candidate);
      if (picked.length >= wanted) break;
    }
  }
  // Read in document order: a revision summary is easier to follow that way.
  picked.sort((a, b) => a.passageIndex - b.passageIndex || a.sentenceIndex - b.sentenceIndex);
  return picked;
}

/** The deterministic summary, used with no API key and as the fallback. */
export function buildLocalSummary({ passages, length, language, keyTerms = [], documents = [] }) {
  const L = LABELS[language] ?? LABELS.en;
  const def = SUMMARY_LENGTHS.find((l) => l.id === length) ?? SUMMARY_LENGTHS[1];
  const scored = rankSentences(passages);
  const picked = pickSpread(scored, def.points);

  if (picked.length === 0) {
    return {
      markdown: [
        `**${L.overview}**`,
        language === 'bn'
          ? 'এই উপকরণ থেকে সারসংক্ষেপ বানানোর মতো পুরো বাক্য পাওয়া যায়নি।'
          :        'No complete sentences could be read out of this material, so there is nothing to summarise yet.',
        '',
        _${L.local}_`,
      ].join('\n'),
      picked,
    };
  }

  return { markdown, picked };
      picked,
    };
  }

  // The first picked sentence usually states the subject; lead with it, and
  // never repeat that same sentence as a bullet underneath itself.
  const overviewSource = picked[0] ?? null;
  const pointSources = picked.length > 1 ? picked.slice(1) : picked;
  const points = pointSources.map(
    (item) => `- ${item.text} [${item.passage.idHint ?? item.passage.id ?? 'S1'}]`,
  );
  const terms = keyTerms.slice(0, def.terms).map((term) => {
    const where = term.pageNumber ? ` (${term.documentName} p.${term.pageNumber})` : '';
    return `- **${term.term}**${where}`;
  });

  const headings = [];
  for (const passage of passages) {
    const heading = String(passage.heading ?? '').trim();
    if (!heading || headings.includes(heading)) continue;
    headings.push(heading);
    if (headings.length >= 8) break;
  }
  const order =
    headings.length > 0
      ? headings.map((heading, index) => `${index + 1}. ${heading}`).join('\n')
      : documents
          .slice(0, 8)
          .map((name, index) => `${index + 1}. ${name}`)
          .join('\n');

  let overview;
  if (overviewSource) {
    overview = `${overviewSource.text} [${overviewSource.passage.idHint ?? overviewSource.passage.id ?? 'S1'}]`;
  } else if (documents.length > 0) {
    const firstDoc = documents[0];
    const firstPage = 1;
    overview = `${L.firstRead ?? 'The material states directly on'} ${firstDoc} ${pageLabel} ${firstPage}.`;
  } else {
    overview = '(no text available)';
  }

  const markdown = [
    `**${L.overview}**`,
    overview,
    '',
    `**${L.points}**`,
    points.join('\n'),
    '',
    `**${L.terms}**`,
    terms.length > 0 ? terms.join('\n') : '_No repeated terms were found in this material._',
    '',
    `**${L.order}**`,
    order || '- Read the material from the start.',
    '',
    `    _${L.local}_`,
  ].join('\n');

  return { markdown, picked };
}

/**
 * Lead sentence for a summary of a single document, extracted directly from
 * the source bytes so it never has to be invented by the model.
 * @param {Buffer} buffer
 * @param {string} format one of the values returned by resolveFormat()
 */
export async function documentOverviewText(buffer, format) {
  if (format === 'pdf') {
    return pdfOverviewText(buffer);
  }
  if (format === 'docx') {
    return normaliseText(docxToText(buffer).text).slice(0, 1400);
  }
  if (format === 'odt') {
    return normaliseText(odtToText(buffer).text).slice(0, 1400);
  }
  if (format === 'doc') {
    return normaliseText(legacyDocToText(buffer).text).slice(0, 1400);
  }
  if (format === 'rtf') {
    return normaliseText(rtfToText(buffer).text).slice(0, 1400);
  }
  return '';
}
export function createSummaryService({ store, retrieval, provider, config, logger }) {
  const providerInfo = provider ? { id: provider.id, label: provider.label, model: provider.model } : null;

  /**
   * @param {{learnerId:string, materialIds?:string[]|null, length?:string, language?:'en'|'bn'|null, focus?:string}} params
   */
  async function summarise({ learnerId, materialIds = null, length = DEFAULT_SUMMARY_LENGTH, language = null, focus = '' }) {
    const safeLength = SUMMARY_LENGTHS.some((l) => l.id === length) ? length : DEFAULT_SUMMARY_LENGTH;

    const all = await retrieval.allPassages(learnerId, materialIds);
    if (all.length === 0) {
      const materials = await store.listMaterials(learnerId);
      return {
        ok: false,
        code: materials.length === 0 ? 'no_materials' : 'no_passages',
        message:
          materials.length === 0
            ? 'Upload a document first: a summary can only be built from your own material.'
            : 'The selected material has no indexed text yet. Check My Materials for what happened during upload.',
      };
    }

    // Document order, so the summary follows the material in the order the
    // student selected (or added) it, not the order passages happen to be
    // stored in.
    const selection = Array.isArray(materialIds) && materialIds.length > 0 ? new Map(materialIds.map((id, i) => [id, i])) : null;
    const ordered = [...all].sort(
      (a, b) =>
        (selection?.get(a.materialId) ?? 0) - (selection?.get(b.materialId) ?? 0) ||
        String(a.material?.createdAt ?? '').localeCompare(String(b.material?.createdAt ?? '')) ||
        String(a.documentName).localeCompare(String(b.documentName)) ||
        (a.pageNumber ?? 0) - (b.pageNumber ?? 0) ||
        (a.index ?? 0) - (b.index ?? 0),
    );

    const documents = [...new Set(ordered.map((p) => p.documentName))];
    const detected = ordered.find((p) => p.material?.language)?.material?.language ?? null;

    // Lead-sentence candidate for the Overview: a short, real excerpt we can
    // quote without asking the model to invent one.
    let overviewSource = null;
    if (documents.length === 1) {
      const firstPassage = ordered[0];
      const rawText = firstPassage.text.slice(0, 1400);
      if (rawText.trim().length >= 40) {
        overviewSource = { text: rawText, passage: { id: firstPassage.id, idHint: firstPassage.id, documentName: firstPassage.documentName, pageNumber: firstPassage.pageNumber } };
      }
    }

    const resolvedLanguage = language ?? detected ?? 'en';

    // Coverage first: the whole document has to fit the budget, not the top hits.
    const budget = safeLength === 'detailed' ? config.retrieval.summaryChars * 1.6 : config.retrieval.summaryChars;
    const { selected, truncated } = selectSpread(ordered, Math.round(budget));

    if (!overviewSource && documents.length === 1 && selected.length > 0) {
      // Prefer the spread sample so the lead sentence is representative, but
      // fall back to the first passage if the sample is too short.
      const candidate = selected.find((p) => p.text.trim().length >= 40) ?? selected[0];
      overviewSource = { text: candidate.text.slice(0, 1400), passage: { id: candidate.id, idHint: candidate.id, documentName: candidate.documentName, pageNumber: candidate.pageNumber } };
    }

    const { passages, notes, truncated: contextTruncated, usedChars } = preparePassages(
      selected.map((p) => ({ ...p, score: undefined })),
      { contextChars: Math.round(budget) },
    );

    // [S#] ids are assigned on the way in, so the local summary can cite the
    // same ids the model sees. The mapping is kept here rather than written
    // onto the passages, because those objects are shared with the search index.
    const shortIdByIndex = new Map(passages.map((passage, index) => [index, passage.id]));

    const keyTerms = extractKeyTerms(ordered, { limit: safeLength === 'detailed' ? 16 : 10 });

    let rawSummary = null;
    let fallback = null;
    let generationMode = 'demo';
    const warnings = [...notes];

    if (truncated || contextTruncated) {
      warnings.push({
        code: 'summary_sampled',
        message: `This material is longer than one summary can cover, so ${passages.length} of ${ordered.length} passages were sampled evenly across it. Every part of the document is represented.`,
      });
    }

    if (provider) {
      try {
        const startedAt = Date.now();
        const response = await provider.chat({
          messages: buildSummaryMessages({
            passages,
            length: safeLength,
            language: resolvedLanguage,
            focus,
            documents,
          }),
          temperature: 0.3,
          maxTokens: safeLength === 'detailed' ? 2600 : 1700,
        });
        rawSummary = response.content;
        generationMode = 'live';
        logger.info('summary generated', {
          learnerId,
          provider: provider.id,
          model: provider.model,
          ms: Date.now() - startedAt,
          passages: passages.length,
          length: safeLength,
        });
      } catch (err) {
        fallback = { code: err.code ?? 'ai_provider_error', message: err.message };
        logger.warn('ai provider failed, falling back to local summary', {
          learnerId,
          provider: provider.id,
          code: fallback.code,
          message: err.message,
        });
        warnings.push({
          code: 'ai_provider_fallback',
          message: `${err.message} This summary was built locally from your material instead.`,
        });
      }
    }

    if (rawSummary === null) {
      const local = buildLocalSummary({
        // Only the passages that made it into the context have an [S#] id, and
        // every sentence the local summary quotes must carry a citation that
        // resolves to one of them.
        passages: selected.slice(0, passages.length).map((p, index) => ({ ...p, idHint: shortIdByIndex.get(index) })),
        length: safeLength,
        language: resolvedLanguage,
        keyTerms,
        documents,
      });
      rawSummary = local.markdown;
    }

    const { citations, invalidIds, citedIds } = validateCitations(rawSummary, passages);
    const cleaned = clampAnswer(stripInvalidCitations(rawSummary, invalidIds));
    const unsupportedQuotes = findUnsupportedQuotes(cleaned, passages);

    if (invalidIds.length > 0) {
      warnings.push({
        code: 'invalid_citations_removed',
        message: `Removed ${invalidIds.length} citation${invalidIds.length > 1 ? 's' : ''} that did not match any supplied passage.`,
      });
    }
    if (unsupportedQuotes.length > 0) {
      warnings.push({
        code: 'unverified_quotation',
        message: `${unsupportedQuotes.length} quotation${unsupportedQuotes.length > 1 ? 's' : ''} could not be found in the supplied passages. Treat them with suspicion.`,
      });
    }

    const provenance =
      generationMode === 'live'
        ? `${providerInfo.label} (${providerInfo.model}) summarised ${passages.length} passage(s) sampled from ${documents.length} document(s). Every citation was verified against the passages that were supplied, and ${citedIds.length} were used.`
        : fallback
          ? `Built locally by quoting your own material. The AI provider could not be used: ${fallback.message} Every citation was checked against the passages that were supplied, and ${citedIds.length} were used.`
          : `Built locally by selecting and quoting sentences from your own material. Every citation was checked against the passages that were supplied, and ${citedIds.length} were used. No AI provider key is configured, so no text left this machine.`;

    return {
      ok: true,
      summary: cleaned,
      generationMode,
      provider: providerInfo,
      fallback,
      citations,
      keyTerms,
      warnings,
      unsupportedQuotes,
      language: resolvedLanguage,
      length: safeLength,
      provenance,
      stats: {
        documents,
        passagesAvailable: ordered.length,
        passagesUsed: passages.length,
        contextCharsUsed: usedChars,
        truncated: truncated || contextTruncated,
      },
    };
  }

  return { summarise, providerInfo };
}

export default createSummaryService;

/**
 * Lead sentence for a summary of a single document, extracted directly from
 * the source bytes so it never has to be invented by the model.
 * @param {Buffer} buffer
 * @param {string} format one of the values returned by resolveFormat()
 */
export async function documentOverviewText(buffer, format) {
  if (format === 'pdf') {
    return pdfOverviewText(buffer);
  }
  if (format === 'docx') {
    return normaliseText(docxToText(buffer).text).slice(0, 1400);
  }
  if (format === 'odt') {
    return normaliseText(odtToText(buffer).text).slice(0, 1400);
  }
  if (format === 'doc') {
    return normaliseText(legacyDocToText(buffer).text).slice(0, 1400);
  }
  if (format === 'rtf') {
    return normaliseText(rtfToText(buffer).text).slice(0, 1400);
  }
  return '';
}
