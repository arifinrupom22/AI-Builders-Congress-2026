# =============================================================================
# LearnSphere AI - environment template
# Copy to `.env` and fill in ONLY what you need. Never commit `.env`.
# ---------------------------------------------------------------------------
# THE APP RUNS WITHOUT ANY OF THIS.
# With no AI key set, LearnSphere AI runs in "demo" mode: real document
# extraction, real BM25 retrieval, real source citations, and deterministic
# quiz generation - all locally. AI keys only upgrade answers/quiz wording.
# =============================================================================

# --- Server ---
PORT=8787
NODE_ENV=development
# Number of reverse-proxy hops to trust for client IPs (rate limiting).
# Leave 0 unless this server really sits behind a proxy you control; a value
# here decides whether X-Forwarded-For is believed at all.
TRUST_PROXY=0

# --- Identity ---
# local    = single-user/demo. X-Learner-Id scopes data but is NOT authentication.
# required = server-verified email+password accounts; every API route except
#            /api/health, /api/config and /api/auth needs a session.
# Production defaults to `required`; development defaults to `local`.
AUTH_MODE=
SESSION_TTL_DAYS=14
# Invitation policy for `required` mode.
#   allowlist (default) - only the five team addresses in server/src/auth/team.js
#                         can register; the list is never sent to the browser.
#   open                - any email address may create an account.
# AUTH_REGISTRATION_POLICY=allowlist
# Shared password for the five authorised accounts. There is no built-in
# fallback: without this value a required server creates no accounts and logs
# a warning. Quote it when it contains '#', which otherwise starts a comment.
# Apply it to existing accounts (in place, keeping their data) with:
#   npm run team:set-password
# TEAM_BOOTSTRAP_PASSWORD='your password here'
# Password-reset token lifetime, and whether a non-production deployment may
# show the one-time token on the page (there is no bundled email provider).
# AUTH_RESET_TTL_MINUTES=30
# AUTH_DEV_RESET=0
# Production only: comma-separated browser origins allowed to call this API.
# Example: https://your-site.onrender.com
CORS_ALLOWED_ORIGINS=

# --- AI provider (optional) -------------------------------------------------
# Leave LEARNSPHERE_AI_PROVIDER empty (or "none") for offline demo mode.
#
# Allowed values:
#   none | groq | gemini | openrouter | mistral | cloudflare | custom
#
# PRIVACY NOTE (verified Oct 2026):
#   groq        - free tier, and Groq does NOT train on your data. Best default.
#   cloudflare  - free allocation, does not train on your content.
#   gemini      - free tier; Google MAY use free-tier prompts to improve models.
#   openrouter  - free models available; privacy depends on the upstream model.
#   mistral     - free mode may use inputs to train unless you opt out.
# Because of that, the safe default here is `none` (pure local demo mode).
LEARNSPHERE_AI_PROVIDER=none

# --- Provider API key (server-side only; never sent to the browser) --------
# Groq:       https://console.groq.com/keys
# Gemini:     https://aistudio.google.com/apikey
# OpenRouter: https://openrouter.ai/keys
# Mistral:    https://console.mistral.ai/
# Cloudflare: https://dash.cloudflare.com/profile/api-tokens
LEARNSPHERE_AI_API_KEY=

# --- Model id. Leave blank to use the provider's default. ------------------
# groq:       openai/gpt-oss-20b
# gemini:     gemini-3-flash-preview  (gemini-2.5-flash 404s for new keys)
# openrouter: openrouter/free
# mistral:    mistral-small-latest
# cloudflare: @cf/meta/llama-3.1-8b-instruct
LEARNSPHERE_AI_MODEL=

# --- Fallback providers (optional, up to three) ----------------------------
# Tried in order when the primary provider fails: a rate limit, an exhausted
# free tier, or a key that stops working. Each slot needs a provider and a key;
# the model and base URL default to that provider's preset. Two Gemini slots are
# the usual choice, so a second key carries the demo if the first is throttled.
# A slot that is half filled is skipped and named in the startup warnings.
#
# LEARNSPHERE_AI_FALLBACK1_PROVIDER=gemini
# LEARNSPHERE_AI_FALLBACK1_API_KEY=
# LEARNSPHERE_AI_FALLBACK1_MODEL=gemini-3-flash-preview
#
# LEARNSPHERE_AI_FALLBACK2_PROVIDER=gemini
# LEARNSPHERE_AI_FALLBACK2_API_KEY=
#
# LEARNSPHERE_AI_FALLBACK3_PROVIDER=openrouter
# LEARNSPHERE_AI_FALLBACK3_API_KEY=

# --- Advanced (only set these for `custom` or a self-hosted gateway) -------
# LEARNSPHERE_AI_BASE_URL=https://api.example.com/v1

# --- Cloudflare Workers AI only -------------------------------------------
# CF_ACCOUNT_ID=
# LEARNSPHERE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# --- Firebase Authentication (identity) -----------------------------------
# Set these to make Firebase the only sign-in provider. Without
# FIREBASE_PROJECT_ID the server keeps the built-in password accounts, which is
# what local development and the five not-yet-migrated team accounts use.
# Only the project id is required to verify ID tokens: the signing certificates
# are fetched from Google and cached in memory.
FIREBASE_PROJECT_ID=
# Optional; only needed if a future Admin SDK call is added.
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes and wrap the value in double quotes.
FIREBASE_PRIVATE_KEY=

# The browser config is public by design and is read at BUILD time by Vite.
# A build without it simply never loads the Firebase SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Supabase (application data) ------------------------------------------
# Both values are required to switch storage to Supabase PostgreSQL + Storage.
# Set them on the server only: the service-role key bypasses Row Level Security
# and must never be exposed to the browser or committed.
# Apply supabase/migrations/0001_init.sql before the first start.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to the private "materials" bucket.
# SUPABASE_STORAGE_BUCKET=materials

# --- Limits / tuning (all optional) ---------------------------------------
MAX_UPLOAD_MB=20
MAX_DOCUMENTS=50
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35
RATE_LIMIT_PER_MINUTE=120
AI_TIMEOUT_MS=45000
