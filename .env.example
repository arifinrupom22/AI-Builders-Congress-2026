# =============================================================================
# LearnSphere AI - environment template
# Copy to `.env` and fill in ONLY what you need. Never commit `.env`.
# ---------------------------------------------------------------------------
# THE APP RUNS WITHOUT ANY OF THIS.
# With no AI key set, LearnSphere AI runs in "demo" mode: real document
# extraction, real BM25 retrieval, real source citations, and deterministic
# quiz generation - all locally. AI keys only upgrade answers/quiz wording.
# =============================================================================

# --- Server ---
PORT=8787
NODE_ENV=development
# Production only: comma-separated browser origins allowed to call this API.
# Example: https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=

# --- AI provider (optional) -------------------------------------------------
# Leave LEARNSPHERE_AI_PROVIDER empty (or "none") for offline demo mode.
#
# Allowed values:
#   none | groq | gemini | openrouter | mistral | cloudflare | custom
#
# PRIVACY NOTE (verified Oct 2026):
#   groq        - free tier, and Groq does NOT train on your data. Best default.
#   cloudflare  - free allocation, does not train on your content.
#   gemini      - free tier; Google MAY use free-tier prompts to improve models.
#   openrouter  - free models available; privacy depends on the upstream model.
#   mistral     - free mode may use inputs to train unless you opt out.
# Because of that, the safe default here is `none` (pure local demo mode).
LEARNSPHERE_AI_PROVIDER=none

# --- Provider API key (server-side only; never sent to the browser) --------
# Groq:       https://console.groq.com/keys
# Gemini:     https://aistudio.google.com/apikey
# OpenRouter: https://openrouter.ai/keys
# Mistral:    https://console.mistral.ai/
# Cloudflare: https://dash.cloudflare.com/profile/api-tokens
LEARNSPHERE_AI_API_KEY=

# --- Model id. Leave blank to use the provider's default. ------------------
# groq:       openai/gpt-oss-20b
# gemini:     gemini-2.5-flash
# openrouter: openrouter/free
# mistral:    mistral-small-latest
# cloudflare: @cf/meta/llama-3.1-8b-instruct
LEARNSPHERE_AI_MODEL=

# --- Advanced (only set these for `custom` or a self-hosted gateway) -------
# LEARNSPHERE_AI_BASE_URL=https://api.example.com/v1

# --- Cloudflare Workers AI only -------------------------------------------
# CF_ACCOUNT_ID=
# LEARNSPHERE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# --- Limits / tuning (all optional) ---------------------------------------
MAX_UPLOAD_MB=20
MAX_DOCUMENTS=50
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35
RATE_LIMIT_PER_MINUTE=120
AI_TIMEOUT_MS=45000
